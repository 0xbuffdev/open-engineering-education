#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: new-course-workspace <track> <course-code> [workspace-dir]

Creates the learner workspace files (labs, exercises, notes) for one course.
The course file itself is never copied: it stays in the OEE curriculum and the
generated files link to it.

Arguments:
  track          foundations | systems | ai | security
  course-code    e.g. F2, S1, AI6, D3
  workspace-dir  where to create the workspace. Defaults to $OEE_WORKSPACE,
                 then to the current directory.

The workspace must be your own study workspace repository. Run this from its
root, or pass its path. It refuses to write into the OEE repository itself.
EOF
}

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  usage
  exit 64
fi

track="$1"
course="$2"

case "$track" in
  foundations) prefix="F" ;;
  systems) prefix="S" ;;
  ai) prefix="AI" ;;
  security) prefix="D" ;;
  *)
    echo "Unknown track: $track" >&2
    echo "Choose one of: foundations, systems, ai, security" >&2
    exit 64
    ;;
esac

if ! [[ "$course" =~ ^${prefix}[0-9]+$ ]]; then
  echo "Invalid course code '$course' for track '$track'." >&2
  echo "Expected ${prefix} followed by a number, for example ${prefix}1." >&2
  exit 64
fi

repository_root="$(cd "$(dirname "$0")/.." && pwd)"
course_dir="$repository_root/curriculum/$track"

if [ ! -d "$course_dir" ]; then
  echo "Curriculum track directory not found: $course_dir" >&2
  exit 1
fi

shopt -s nullglob
matches=("$course_dir/$course"-*.md)
shopt -u nullglob

if [ "${#matches[@]}" -ne 1 ]; then
  echo "Course '$course' was not found uniquely in $course_dir." >&2
  echo "Run: find curriculum/$track -maxdepth 1 -name '$course-*.md'" >&2
  exit 64
fi

course_file="${matches[0]}"
course_name="$(basename "$course_file")"

# The course file lives in the OEE repository, not in the workspace, so
# generated files link to it there. Override with OEE_CURRICULUM_URL when
# working from a fork or a local clone.
oee_url="${OEE_CURRICULUM_URL:-https://github.com/0xbuffdev/open-engineering-education/blob/main}"
course_link="$oee_url/curriculum/$track/$course_name"

# Target: argument, then $OEE_WORKSPACE, then the current directory.
workspace="${3:-${OEE_WORKSPACE:-.}}"
if [ ! -d "$workspace" ]; then
  echo "Workspace directory does not exist: $workspace" >&2
  echo "Run this from your study workspace root, or pass its path." >&2
  exit 1
fi
workspace="$(cd "$workspace" && pwd)"

if [ "$workspace" = "$repository_root" ]; then
  echo "Refusing to create a learner workspace inside the OEE repository." >&2
  echo "Learner work belongs in your own study workspace; see README.md." >&2
  echo "Run this from your workspace root, or pass it: $0 $track $course <workspace-dir>" >&2
  exit 1
fi

template_dir="$repository_root/templates/course-workspace"
lab_dir="$workspace/labs/$track/$course"
exercise_dir="$workspace/exercises/$track/$course"
notes_dir="$workspace/notes/$track/$course"

for destination in "$lab_dir" "$exercise_dir" "$notes_dir"; do
  if [ -e "$destination" ]; then
    echo "Workspace already exists: $destination" >&2
    exit 1
  fi
done

mkdir -p "$lab_dir" "$exercise_dir" "$notes_dir"

for template_and_destination in \
  "lab-README.md:$lab_dir/README.md" \
  "exercises-README.md:$exercise_dir/README.md" \
  "resources.md:$notes_dir/resources.md" \
  "summary.md:$notes_dir/summary.md"; do
  template="${template_and_destination%%:*}"
  destination="${template_and_destination#*:}"
  sed -e "s|<course>|$course|g" \
      -e "s|<course_link>|$course_link|g" \
      "$template_dir/$template" > "$destination"
done

echo "Created workspace for $course in $workspace:"
echo "  labs/$track/$course/"
echo "  exercises/$track/$course/"
echo "  notes/$track/$course/"
echo "Course file: $course_link"
