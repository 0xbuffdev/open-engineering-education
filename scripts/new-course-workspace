#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <track> <course-code>" >&2
  echo "Example: $0 foundations F2" >&2
  echo "Tracks: foundations, systems, ai, security" >&2
  exit 64
fi

track="$1"
course="$2"

case "$track" in
  foundations) prefix="F" ;;
  systems) prefix="S" ;;
  ai) prefix="AI" ;;
  security) prefix="D" ;;
  *)
    echo "Unknown track: $track" >&2
    echo "Choose one of: foundations, systems, ai, security" >&2
    exit 64
    ;;
esac

if ! [[ "$course" =~ ^${prefix}[0-9]+$ ]]; then
  echo "Invalid course code '$course' for track '$track'." >&2
  echo "Expected ${prefix} followed by a number, for example ${prefix}1." >&2
  exit 64
fi

repository_root="$(cd "$(dirname "$0")/.." && pwd)"
course_dir="$repository_root/curriculum/$track"

if [ ! -d "$course_dir" ]; then
  echo "Curriculum track directory not found: $course_dir" >&2
  exit 1
fi

shopt -s nullglob
matches=("$course_dir/$course"-*.md)
shopt -u nullglob

if [ "${#matches[@]}" -ne 1 ]; then
  echo "Course '$course' was not found uniquely in $course_dir." >&2
  echo "Run: find curriculum/$track -maxdepth 1 -name '$course-*.md'" >&2
  exit 64
fi

course_file="${matches[0]}"
course_name="$(basename "$course_file")"
relative_course="../../../curriculum/$track/$course_name"

template_dir="$repository_root/templates/course-workspace"
lab_dir="$repository_root/labs/$track/$course"
exercise_dir="$repository_root/exercises/$track/$course"
notes_dir="$repository_root/notes/$track/$course"

for destination in "$lab_dir" "$exercise_dir" "$notes_dir"; do
  if [ -e "$destination" ]; then
    echo "Workspace already exists: $destination" >&2
    exit 1
  fi
done

mkdir -p "$lab_dir" "$exercise_dir" "$notes_dir"

for template_and_destination in \
  "lab-README.md:$lab_dir/README.md" \
  "exercises-README.md:$exercise_dir/README.md" \
  "resources.md:$notes_dir/resources.md" \
  "summary.md:$notes_dir/summary.md"; do
  template="${template_and_destination%%:*}"
  destination="${template_and_destination#*:}"
  sed -e "s|<course>|$course|g" \
      -e "s|<course_link>|$relative_course|g" \
      "$template_dir/$template" > "$destination"
done

echo "Created workspace for $course:"
echo "  labs/$track/$course/"
echo "  exercises/$track/$course/"
echo "  notes/$track/$course/"
echo "Course file: curriculum/$track/$course_name"
