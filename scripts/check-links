#!/usr/bin/env python3
"""Check that every relative link in the tracked Markdown files resolves.

Usage: scripts/check-links [repo-root]

Checks relative file links, their #fragments against generated heading
anchors, and same-file #anchors. External links (http, https, mailto) are
not fetched: this is an offline check, so CI stays deterministic.

Exit status: 0 when everything resolves, 1 when any link is broken.
"""

import re
import subprocess
import sys
from pathlib import Path

LINK_RE = re.compile(r"\[([^\]]*)\]\(([^)]+)\)")
HEADING_RE = re.compile(r"^#{1,6}\s+(.*?)\s*#*\s*$", re.MULTILINE)
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
FENCE_RE = re.compile(r"^(```|~~~).*?^\1\s*$", re.MULTILINE | re.DOTALL)
NON_SLUG_RE = re.compile(r"[^\w\- ]")


def slugify(heading: str, seen: dict) -> str:
    """GitHub's heading anchor algorithm (GFM slugger)."""
    text = heading.strip().lower()
    # strip markdown formatting from the heading itself
    text = re.sub(r"[*_`]", "", text)
    text = NON_SLUG_RE.sub("", text)
    slug = text.replace(" ", "-")
    count = seen.get(slug, 0)
    seen[slug] = count + 1
    return slug if count == 0 else f"{slug}-{count}"


def anchors_of(path: Path) -> set:
    seen: dict = {}
    text = path.read_text(encoding="utf-8", errors="replace")
    text = FENCE_RE.sub("", text)
    anchors = set()
    for match in HEADING_RE.finditer(text):
        anchors.add(slugify(match.group(1), seen))
    # explicit HTML anchors
    for anchor in re.findall(r'<a\s+(?:id|name)="([^"]+)"', text):
        anchors.add(anchor)
    return anchors


def markdown_files(root: Path):
    out = subprocess.run(
        ["git", "ls-files", "-z", "*.md", "AUTHORS", "NOTICE"],
        cwd=root, capture_output=True, text=True, check=True,
    )
    return [root / f for f in out.stdout.split("\0") if f]


def strip_non_content(text: str) -> str:
    text = FENCE_RE.sub("", text)
    text = INLINE_CODE_RE.sub(lambda m: " " * len(m.group(0)), text)
    return text


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    failures = []
    checked = 0

    for md in markdown_files(root):
        text = strip_non_content(md.read_text(encoding="utf-8", errors="replace"))
        rel_md = str(md.relative_to(root))
        for match in LINK_RE.finditer(text):
            target = match.group(2).strip()
            if " " in target:  # optional link title after the target
                target = target.split(" ", 1)[0]
            # angle-bracket targets are HTML or autolinks; external links are
            # not fetched offline.
            if not target or target.startswith(("<", "http://", "https://", "mailto:", "tel:")):
                continue
            checked += 1
            where = f"{rel_md}: ...{match.group(0)[:60]}"

            if target.startswith("#"):
                fragment = target[1:]
                if fragment not in anchors_of(md):
                    failures.append(f"{where} -> missing anchor #{fragment}")
                continue

            path_part, _, fragment = target.partition("#")
            resolved = (md.parent / path_part).resolve()
            if not resolved.exists():
                failures.append(f"{where} -> no such file: {path_part}")
                continue
            if fragment and resolved.is_file() and resolved.suffix == ".md":
                if fragment not in anchors_of(resolved):
                    failures.append(
                        f"{where} -> missing anchor #{fragment} in "
                        f"{resolved.relative_to(root) if root in resolved.parents else resolved}"
                    )

    if failures:
        print(f"Broken links ({len(failures)} of {checked} relative links checked):\n")
        for failure in failures:
            print(f"  {failure}")
        return 1
    print(f"OK: {checked} relative links checked, all resolve.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
