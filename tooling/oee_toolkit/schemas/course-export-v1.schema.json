{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xbuffdev/open-engineering-education/blob/main/tooling/oee_toolkit/schemas/course-export-v1.schema.json",
  "title": "OEE Toolkit Draft Derived Course Export — Format 1",
  "description": "Structural snapshot only; not a normative authoring format, conformance assessment or learner evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exportVersion",
    "source",
    "course",
    "outcomes",
    "assessments",
    "modules",
    "coverage",
    "validation"
  ],
  "properties": {
    "exportVersion": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "specification",
        "coursePath"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "const": "0xbuffdev/open-engineering-education"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "specification": {
          "type": "string",
          "const": "v0.2.0"
        },
        "coursePath": {
          "type": "string",
          "pattern": "^curriculum/[A-Z]{2,6}/[A-Z]{2,6}[1-9][0-9]*\\.md$"
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "program",
        "type",
        "status",
        "prerequisites"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}[1-9][0-9]*$"
        },
        "program": {
          "type": "string",
          "minLength": 2
        },
        "type": {
          "enum": [
            "course",
            "project"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "tested",
            "verified"
          ]
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}[1-9][0-9]*$"
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}[1-9][0-9]*-O[1-9][0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "outcomeIds",
          "work",
          "criteria",
          "evidence",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}[1-9][0-9]*-AS[1-9][0-9]*$"
          },
          "required": {
            "type": "boolean"
          },
          "outcomeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}[1-9][0-9]*-O[1-9][0-9]*$"
            }
          },
          "work": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "outcomeIds",
          "lessons"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outcomeIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,6}[1-9][0-9]*-O[1-9][0-9]*$"
            }
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ordinal",
                "title"
              ],
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "patternProperties": {
        "^[A-Z]{2,6}[1-9][0-9]*-O[1-9][0-9]*$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,6}[1-9][0-9]*-AS[1-9][0-9]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural",
        "manualReviewRequired"
      ],
      "properties": {
        "structural": {
          "const": "passed"
        },
        "manualReviewRequired": {
          "const": true
        }
      }
    }
  }
}
